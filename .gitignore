# ============================================================
# Git Analysis for Obsidian — .gitignore
# ============================================================

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ---- Build outputs ----
dist/
build/
*.min.js
*.min.css
*.map

# ---- IDE / Editor ----
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Obsidian specific ----
# Игнорируем настройки рабочего пространства (чтобы не засорять репозиторий)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/community-plugins.json
.obsidian/plugins/
.obsidian/themes/

# ---- Plugin data (локальные данные, не должны попадать в репозиторий) ----
data.json
.git-analysis-data/
*.log

# ---- Environment ----
.env
.env.local
.env.*.local

# ---- Temporary files ----
tmp/
temp/
*.tmp
*.bak

# ---- System files ----
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Archive / backups ----
*.zip
*.tar.gz
*.7z
*.rar
*.bak
*.backup

# ---- Output from analysis (если создаются) ----
Git-analysis_*.md